# Environment variables and secrets (NEVER COMMIT API KEYS)
.env
*.env.local

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Large raw archives & datasets (never commit raw/processed data directly)
data/raw/binance/
data/raw/uniswap/*/*.json
data/raw/uniswap/*/*.csv
!data/raw/uniswap/toolkit_sample/
data/processed/*.csv
data/processed/*.parquet
